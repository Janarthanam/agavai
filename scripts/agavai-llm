#!/usr/bin/env bash
# Start llama-server for agavai. Model, host, port, and GPU layers come from
# ~/.config/agavai/config.toml (see `agavai model` / `agavai dump-llm`).
# Does not replace voxtype-sanitize on :18765.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
eval "$(python3 -m agavai dump-llm)"
LOG_DIR="${XDG_RUNTIME_DIR:-/tmp}/agavai"
mkdir -p "$LOG_DIR"

if [[ ! -x "$BIN" ]]; then
  echo "missing llama-server: $BIN" >&2
  echo "Set [llm] llama_bin in ~/.config/agavai/config.toml" >&2
  exit 1
fi
if [[ ! -f "$MODEL" ]]; then
  echo "missing model: $MODEL" >&2
  echo "Active id: ${MODEL_ID:-unknown}. Download with: $ROOT/scripts/download-model.sh ${MODEL_ID:-}" >&2
  exit 1
fi

cd "$(dirname "$BIN")"
exec "$BIN" \
  --model "$MODEL" \
  --host "$HOST" \
  --port "$PORT" \
  --jinja \
  --alias "$ALIAS" \
  --ctx-size "$CTX" \
  --parallel 1 \
  --n-gpu-layers "$NGL"
